# Used ONLY by tests/helpers/admin-client.ts for test setup and cleanup
# against your LOCAL Supabase. The app never reads this (see CLAUDE.md, decision 3).
#
# Copy this file to .env.test.local and fill in the value from:
#   npx supabase status        (the "service_role key" / SERVICE_ROLE_KEY line)
#
# Never prefix it with NEXT_PUBLIC_ (that would ship it to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: where API tests send requests (default http://localhost:3000).
# The app must be running first: `npm run dev`.
# TEST_BASE_URL=http://localhost:3000
